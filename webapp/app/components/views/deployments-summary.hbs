{{! Deployments dashboard landing — the empty state is the whole page (no header,
    no data). Primary action drills into the deployments list. }}
<div class="dep-summary">
  <div class="dep-empty">
    <ds-empty-state
      state-illustration="dashboard"
      title="Nothing to show yet"
      description="Once you create a deployment, its KPIs, activity feed and chart cards will appear here."
      primary-label="Add deployment"
      show-secondary="false"
      {{on "ds-empty-state-primary" this.onPrimary}}
    ></ds-empty-state>
  </div>
</div>
