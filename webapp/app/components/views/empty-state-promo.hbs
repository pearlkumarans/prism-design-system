{{! Empty state — promo variant (ds-empty-state type="promo"): media + title/
    description + action + footer, beside a benefits list. }}
<div style="display:flex;align-items:center;justify-content:center;min-height:100%;padding:32px">
  <ds-empty-state
    type="promo"
    size="md"
    media="create-dashboard"
    title="Introducing DEX Manager Plus"
    description="Measure and improve the real digital experience on every endpoint — experience scores, root-cause insights, and one-click remote fixes."
    primary-label="Start free trial"
    useful-link="#"
    watch-video="#"
    {{set-prop "benefits" this.benefits}}
  ></ds-empty-state>
</div>
