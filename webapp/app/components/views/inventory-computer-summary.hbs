{{! Inventory · Computer summary — the canonical L04 (layout-list-detail.html).
    A thin Patterns::ListDetail instance: RecordHeader (identity · status · IP/owner
    · facet tabs · Actions) over the Summary facet, an L05 read-only ds-widget bento. }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.facet}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" suffix-icon="chevron-down">Actions</ds-button>
  </:headerActions>

  <:body>
    {{#if this.onSummary}}
      <div class="ld-grid">

        {{! R1: Security & Compliance | Disk Usage }}
        <ds-widget class="sp4" title="Security & Compliance" show-drag="false" show-action="false" show-footer="false">
          <div class="ld-sec">
            <div class="ld-health">
              <span class="ld-health__ring"><ds-icon name="exclamation-triangle" size="24"></ds-icon></span>
              <div class="ld-health__text">
                <span class="ld-health__caption">Device Health</span>
                <span class="ld-health__label">Highly Vulnerable</span>
              </div>
              <ds-button variant="outline" size="small" prefix-icon="computer-repair">Fix Now</ds-button>
            </div>
            <div class="ld-checks">
              {{#each this.checks as |c|}}
                <div class="ld-check">
                  <span class="ld-check__ico ld-check__ico--{{c.tone}}"><ds-icon name={{c.icon}} size="16"></ds-icon></span>
                  <div>
                    <div class="ld-check__k">{{c.k}}</div>
                    <div class="ld-check__v">{{c.v}}</div>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        </ds-widget>

        <ds-widget class="sp2" type="chart" title="Disk Usage Summary" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="donut" legend="right" fit="contain" data=this.diskChart}}></ds-widget>

        {{! R2: Software Summary | System Information }}
        <ds-widget class="sp3" type="chart" title="Software Summary" trend="Total: 1250" trend-status="info"
          show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="column" fit="fill" data=this.softwareChart}}></ds-widget>

        <ds-widget class="sp3" title="System Information" trend="Warranty Expired" trend-status="critical"
          show-drag="false" show-action="false" show-footer="false">
          <ds-description-list columns="3" {{set-prop "items" this.sysinfoItems}}></ds-description-list>
        </ds-widget>

        {{! R3: DEX Score | Recent Activity | Sensitive Data }}
        <ds-widget class="sp2 ld-w-dex" title="DEX Score" show-drag="false" show-action="false" show-footer="false">
          <ds-text-link slot="header-action" href="#" size="small">View Details</ds-text-link>
          <ds-chart type="gauge" {{set-prop "data" this.dexChart}}></ds-chart>
          <div class="ld-dex-foot">
            {{#each this.dexLegend as |lg|}}
              <span class="lgd"><span class="sw" style="background: var(--uems-bg-{{lg.swatch}})"></span>{{lg.label}}</span>
            {{/each}}
          </div>
        </ds-widget>

        <ds-widget class="sp2" type="list" title="Recent Activity" show-drag="false" show-action="false" show-footer="false">
          <ds-button slot="filter" variant="outline" size="xsmall" suffix-icon="chevron-down">Last 7 days</ds-button>
          <div class="ld-list">
            {{#each this.activity as |a|}}
              <div class="ld-arow">
                <span class="ld-arow__ico ld-arow__ico--{{a.tile}}"><ds-icon name={{a.icon}} size="18"></ds-icon></span>
                <div class="ld-arow__body">
                  <div class="ld-arow__title">{{a.title}}</div>
                  <div class="ld-arow__meta">
                    <ds-status-indicator class="ld-arow__tag" status={{a.status}} label={{a.tag}} size="medium"></ds-status-indicator>
                    {{#if a.user}}<span>{{a.user}}</span><span class="ld-sep">|</span>{{/if}}
                    <span>{{a.when}}</span>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        </ds-widget>

        <ds-widget class="sp2" type="chart" title="Sensitive Data Distribution" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="donut" legend="right" fit="contain" data=this.sensitiveChart}}></ds-widget>

        {{! R4: Operating System | Agent Summary }}
        <ds-widget class="sp3" title="Operating System" show-drag="false" show-action="false" show-footer="false">
          <ds-text-link slot="header-action" href="#" size="small" leading-icon="refresh">Check Updates</ds-text-link>
          <ds-description-list columns="3" {{set-prop "items" this.osItems}}></ds-description-list>
        </ds-widget>

        <ds-widget class="sp3" title="Agent Summary" trend="Latest" trend-status="success"
          show-drag="false" show-action="false" show-footer="false">
          <ds-description-list columns="3" {{set-prop "items" this.agentItems}}></ds-description-list>
        </ds-widget>

        {{! R5: Additional Device Information | Custom Computer Details }}
        <ds-widget class="sp3" title="Additional Device Information" show-drag="false" show-action="false" show-footer="false">
          <ds-description-list columns="3" {{set-prop "items" this.additionalItems}}></ds-description-list>
        </ds-widget>

        <ds-widget class="sp3" title="Custom Computer Details" show-drag="false" show-action="false" show-footer="false">
          <ds-text-link slot="header-action" href="#" size="small" leading-icon="edit">Modify</ds-text-link>
          <ds-description-list columns="3" {{set-prop "items" this.customItems}}></ds-description-list>
        </ds-widget>

        {{! R6: Custom Fields (empty state) }}
        <ds-widget class="sp2" type="empty" title="Custom Fields"
          state-illustration="formula-column"
          state-title="Custom Fields"
          state-description="Create and manage custom data fields tailored to your workflow."
          retry-label="Add Field" show-drag="false" show-action="false"></ds-widget>

      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state
          show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="Each facet renders an L05 summary or an L03 sub-list.">
        </ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
