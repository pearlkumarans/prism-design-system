{{! Workflows — a thin Patterns::ListView instance (no KPIs, row menu). }}
<Patterns::ListView
  @header={{this.header}}
  @fetch={{this.fetch}}
  @columns={{this.columns}}
  @facets={{this.facets}}
  @rowMenu={{this.rowMenu}}
  @onRowMenu={{this.onRowMenu}}
>
  <:headerActions>
    <ds-button slot="actions" variant="primary" size="small" prefix-icon="add" {{on "click" this.onAddWorkflow}}>
      Add workflow
    </ds-button>
  </:headerActions>
</Patterns::ListView>
