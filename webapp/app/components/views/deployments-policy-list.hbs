{{! All policies — a thin Patterns::ListView instance (name drills to detail). }}
<Patterns::ListView
  @header={{this.header}}
  @fetch={{this.fetch}}
  @columns={{this.columns}}
  @facets={{this.facets}}
  @rowMenu={{this.rowMenu}}
  @onRowMenu={{this.onRowMenu}}
  @onRowLink={{this.onRowLink}}
>
  <:headerActions>
    <ds-split-button
      slot="actions"
      size="small"
      variant="primary"
      label="Add policy"
      {{set-prop "menuItems" this.addPolicyMenu}}
      {{on "ds-split-button-main" this.onAddPolicy}}
      {{on "ds-split-button-menu-select" this.onAddPolicy}}
    ></ds-split-button>
  </:headerActions>
</Patterns::ListView>
