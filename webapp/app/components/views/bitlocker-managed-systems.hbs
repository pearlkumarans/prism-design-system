{{! BitLocker managed computers — a thin Patterns::ListView instance, fully localized
    (i18n header/columns/KPIs/facets, breadcrumbs, localized facet option labels). }}
<Patterns::ListView
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @fetch={{this.fetch}}
  @columns={{this.columns}}
  @facets={{this.localizedFacets}}
  @facetOptionLabel={{this.facetOptionLabel}}
  @kpis={{this.kpis}}
  @bulkActions={{this.bulkActions}}
  @onBulkAction={{this.onBulkAction}}
>
  <:headerActions>
    <ds-button slot="actions" variant="primary" prefix-icon="settings-deploy" {{on "click" this.deploy}}>
      {{t "ms.deploy"}}
    </ds-button>
  </:headerActions>
</Patterns::ListView>
