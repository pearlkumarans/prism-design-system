{{! Deployments list — a thin Patterns::ListView instance. }}
<Patterns::ListView
  @header={{this.header}}
  @fetch={{this.fetch}}
  @columns={{this.columns}}
  @facets={{this.facets}}
  @kpis={{this.kpis}}
  @bulkActions={{this.bulkActions}}
  @onBulkAction={{this.onBulkAction}}
>
  <:headerActions>
    <ds-button slot="actions" variant="primary" prefix-icon="add" {{on "click" this.createDeployment}}>
      Create deployment
    </ds-button>
  </:headerActions>
</Patterns::ListView>
