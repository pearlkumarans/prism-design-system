{{! Native deployments list — binds PrismAPI.deployments.list (the 2nd BFF endpoint)
    with the same server-driven-table contract as managed-computers. Reuses the
    generic .bl-list* list layout. Landing page → no breadcrumb. }}
<div class="bl-list">
  <ds-page-header
    icon="settings-deploy"
    structure="default"
    title="Deployments"
    description="Software, patch, configuration, and script deployments across your fleet."
    show-description
    collapse-on-scroll
    scroll-target=".bl-list__scroll"
  >
    <ds-button slot="actions" variant="primary" prefix-icon="add" {{on "click" this.createDeployment}}>
      Create deployment
    </ds-button>
  </ds-page-header>

  <div class="bl-list__scroll">
    {{#if this.error}}
      <ds-empty-state type="centered" illustration="common-error"
        title="Couldn't load deployments" description="The request failed. Is the BFF running (server/bff.mjs)?"
        primary-label="Retry" show-secondary="false"></ds-empty-state>
    {{else if this.view}}
      <div class="bl-kpis">
        {{#each this.kpis as |k|}}
          <ds-kpi-card label={{k.label}} value={{k.value}} state={{k.state}} icon={{k.icon}}></ds-kpi-card>
        {{/each}}
      </div>

      <div class="bl-list__grid {{if this.filtering "is-filtering"}}">
        <div class="bl-list__filtercol">
          <ds-filter-panel
            class="bl-list__filters"
            title="Filters"
            aria-label="Filters"
            fit-viewport
            {{set-prop "groups" this.filterGroups}}
            {{on "ds-filter-panel-change" this.onFilterChange}}
          ></ds-filter-panel>
        </div>

        <div class="bl-list__tablewrap">
          {{#if this.isLoading}}
            <div class="bl-list__updating" role="status">
              <ds-icon name="loading" size="14"></ds-icon>
              <span>Updating…</span>
            </div>
          {{/if}}
          <ds-data-table
            class="bl-list__table"
            selection-mode="multi"
            row-height="comfortable"
            show-footer
            sticky-header
            rows-per-page={{this.pageSize}}
            page={{this.page}}
            total-rows={{this.total}}
            {{set-prop "columns" this.columns}}
            {{set-prop "rows" this.rows}}
            {{set-prop "bulkActions" this.bulkActions}}
            {{on "ds-data-table-bulk-action" this.onBulkAction}}
            {{on "ds-data-table-page" this.onPage}}
            {{on "ds-data-table-rows-per-page" this.onPageSize}}
            {{on "ds-data-table-search" this.onSearch}}
            {{on "ds-data-table-sort" this.onSort}}
            {{on "ds-data-table-filter" this.onToggleFilter}}
          ></ds-data-table>
        </div>
      </div>
    {{else}}
      <div class="bl-list__loading" role="status">
        <ds-icon name="loading" size="20"></ds-icon>
        <span>Loading deployments…</span>
      </div>
    {{/if}}
  </div>
</div>
