{{! Full shell frame. The chrome modifier wires everything to routed + nav state.
    Layout mirrors Shell.html: header on top; body row of [module rail][shell area][right pane]. }}
<div class="shell-root" {{chrome this this.shell.tabId this.shell.viewSlug this.nav.mode this.nav.railIcons}}>
  <ds-header-nav
    variant={{this.shell.variant}}
    user-initials="AM"
    show-zia="true"
    show-bookmark="false"
  ></ds-header-nav>

  <div class="shell-body">
    {{! Left-nav mode only — module rail relocated to the side (hidden in top-nav). }}
    <ds-module-rail class="shell-modrail" aria-label="Modules" hidden></ds-module-rail>

    {{! The framed content region (Shell.html calls it .shell-area). Injected legacy
        views key off this class — Settings/Zia/Support toggle `.shell-area.<x>-open`
        on it, confined ec-drawers use `.shell-area ds-drawer.ec-drawer`. }}
    <div class="shell-area">
      <ds-sidebar-l1 hide-toggle></ds-sidebar-l1>
      <ds-sidebar-l2 collapse-toggle></ds-sidebar-l2>
      <ds-content role="main">
        {{yield}}
      </ds-content>
    </div>

    {{! Right utility rail — help, accessibility, updates, theme + RTL toggles. }}
    <ds-right-pane show-mobile-app="false" show-call="false"></ds-right-pane>
  </div>
</div>
