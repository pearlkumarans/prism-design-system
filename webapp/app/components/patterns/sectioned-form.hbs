{{! Patterns::SectionedForm — L06 scaffold. Header + scrolling body (yields a
    Section component) + pinned footer + Save-as menu. Fields come from the caller. }}
<div class="sform">
  <ds-page-header
    icon={{this.header.icon}}
    structure="default"
    title={{this.header.title}}
    description={{this.header.description}}
    show-description
    show-breadcrumbs={{if @breadcrumbs "true" "false"}}
    collapse-on-scroll
    scroll-target=".sform__scroll"
    {{set-prop "breadcrumbs" @breadcrumbs}}
  ></ds-page-header>

  <div class="sform__scroll">
    {{yield (hash Section=(component "patterns/sectioned-form/section")) to="body"}}
  </div>

  <ds-form-footer>
    {{#if @footerNote}}<span slot="left">{{@footerNote}}</span>{{/if}}
    <ds-button slot="action" variant="outline" {{on "click" this.onCancel}}>Cancel</ds-button>
    {{#if @saveAsItems}}
      <ds-button slot="action" variant="secondary" suffix-icon="chevron-down" aria-haspopup="menu" {{on "click" this.openSaveAs}}>Save as</ds-button>
    {{/if}}
    <ds-button slot="action" variant="primary" {{on "click" this.onPrimary}}>{{if @primaryLabel @primaryLabel "Save"}}</ds-button>
  </ds-form-footer>

  {{#if @saveAsItems}}
    <ds-dropdown-menu type="single" {{set-prop "items" @saveAsItems}} {{on "ds-dropdown-change" this.onSaveAsChange}}></ds-dropdown-menu>
  {{/if}}
</div>
