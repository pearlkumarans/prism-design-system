{{! Patterns::ListView — L03 list archetype. Renders the whole .bl-list chrome;
    the caller supplies data via @fetch and config via args (see the .js docblock). }}
<div class="bl-list">
  <ds-page-header
    icon={{this.header.icon}}
    structure="default"
    title={{this.header.title}}
    description={{this.header.description}}
    show-description
    show-breadcrumbs={{if @breadcrumbs "true" "false"}}
    collapse-on-scroll
    scroll-target=".bl-list__scroll"
    {{set-prop "breadcrumbs" @breadcrumbs}}
  >
    {{yield to="headerActions"}}
  </ds-page-header>

  <div class="bl-list__scroll">
    {{#if this.error}}
      <ds-empty-state type="centered" illustration="common-error"
        title="Couldn't load" description="The request failed. Is the BFF running (server/bff.mjs)?"
        primary-label="Retry" show-secondary="false" {{on "ds-empty-state-primary" this.reload}}></ds-empty-state>
    {{else if this.view}}
      {{#if this.kpis.length}}
        <div class="bl-kpis">
          {{#each this.kpis as |k|}}
            <ds-kpi-card label={{k.label}} value={{k.value}} state={{k.state}} icon={{k.icon}}></ds-kpi-card>
          {{/each}}
        </div>
      {{/if}}

      <div class="bl-list__grid {{if this.filtering "is-filtering"}}">
        {{#if this.filterGroups.length}}
          <div class="bl-list__filtercol">
            <ds-filter-panel
              class="bl-list__filters"
              title="Filters"
              aria-label="Filters"
              fit-viewport
              {{set-prop "groups" this.filterGroups}}
              {{on "ds-filter-panel-change" this.onFilterChange}}
            ></ds-filter-panel>
          </div>
        {{/if}}

        <div class="bl-list__tablewrap" {{on "click" this.onTableClick}}>
          {{#if this.isLoading}}
            <div class="bl-list__updating" role="status">
              <ds-icon name="loading" size="14"></ds-icon>
              <span>Updating…</span>
            </div>
          {{/if}}
          <ds-data-table
            class="bl-list__table"
            selection-mode={{this.selectionMode}}
            row-height="comfortable"
            show-footer
            sticky-header
            rows-per-page={{this.pageSize}}
            rows-per-page-options={{@rowsPerPageOptions}}
            page={{this.page}}
            total-rows={{this.total}}
            {{set-prop "columns" this.columns}}
            {{set-prop "rows" this.rows}}
            {{set-prop "bulkActions" this.bulkActions}}
            {{on "ds-data-table-bulk-action" this.onBulkAction}}
            {{on "ds-data-table-page" this.onPage}}
            {{on "ds-data-table-rows-per-page" this.onPageSize}}
            {{on "ds-data-table-search" this.onSearch}}
            {{on "ds-data-table-sort" this.onSort}}
            {{on "ds-data-table-filter" this.onToggleFilter}}
          ></ds-data-table>
          {{#if this.hasRowMenu}}
            <ds-dropdown-menu
              class="bl-list__rowmenu"
              type="action"
              {{set-prop "items" this.rowMenu}}
              {{on "ds-dropdown-select" this.onRowMenuSelect}}
            ></ds-dropdown-menu>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div class="bl-list__loading" role="status">
        <ds-icon name="loading" size="20"></ds-icon>
        <span>Loading…</span>
      </div>
    {{/if}}
  </div>
</div>
