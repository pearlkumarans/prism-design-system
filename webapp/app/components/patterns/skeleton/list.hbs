{{! List skeleton — shape-matching placeholder (KPI row + toolbar + table rows). }}
<div class="sk-list" aria-hidden="true" role="status" aria-label="Loading">
  {{#if @kpis}}
    <div class="sk-kpis">
      {{#each this.kpiCells}}<div class="sk sk-kpi"></div>{{/each}}
    </div>
  {{/if}}

  <div class="sk-toolbar">
    <div class="sk sk-search"></div>
    <div class="sk sk-btn"></div>
  </div>

  <div class="sk-table">
    <div class="sk-row sk-row--head">
      {{#each this.cols}}<div class="sk sk-cell"></div>{{/each}}
    </div>
    {{#each this.rows}}
      <div class="sk-row">
        {{#each this.cols}}<div class="sk sk-cell"></div>{{/each}}
      </div>
    {{/each}}
  </div>
</div>
