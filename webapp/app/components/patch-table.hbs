{{! Real ds-* Web Components used directly in a Glimmer template. }}
<div class="poc-toolbar">
  {{! String attributes just work — no bridge needed. }}
  <ds-button variant="primary" size="medium" prefix-icon="plus" {{on "click" this.addRow}}>
    Add patch row
  </ds-button>

  <ds-badge variant="subtle" state="acknowledge" size="medium" shape="rounded">
    {{this.selectedCount}} selected
  </ds-badge>
</div>

{{!
  columns/rows are JS array PROPERTIES → pushed in with {{set-prop}}.
  Custom events → handled with the built-in {{on}} modifier.
}}
<ds-data-table
  selectable="true"
  {{set-prop "columns" this.columns}}
  {{set-prop "rows" this.rows}}
  {{on "ds-data-table-selection" this.onSelection}}
  {{on "ds-data-table-sort" this.onSort}}
></ds-data-table>

<p class="poc-event">Last event: <code>{{this.lastEvent}}</code></p>
