{{! One pattern, rendered in isolation. Header names it; the stage gives it height. }}
<header class="pgal__head">
  <div class="pgal__head-title">
    <span>{{@model.label}}</span>
    <span class="pgal__badge">{{@model.spec}}</span>
  </div>
  <p class="pgal__head-desc">{{@model.desc}}</p>
</header>

<div class="pgal__stage">
  {{component @model.component}}
</div>
