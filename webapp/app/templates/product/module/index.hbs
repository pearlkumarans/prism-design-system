{{! No default view for this tab → an honest empty state instead of a blank
    content area. Tabs with a default view (redirected to it) and full-page drawer
    tabs (redirected to the landing) never reach here — see routes/product/module/index.js. }}
<div style="display:flex;align-items:center;justify-content:center;min-height:100%;padding:32px">
  <ds-empty-state
    type="centered"
    size="md"
    title="{{this.model.label}} isn’t available yet"
    description="This module doesn’t have a page in this workspace yet. Pick another tab to continue."
  ></ds-empty-state>
</div>
