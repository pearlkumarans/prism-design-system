{{! The whole app lives inside the real shell chrome (header + L1/L2 sidebars).
    Routes set shell state; ShellChrome reacts; the routed view renders in ds-content.
    The /patterns preview gallery is the exception — it renders standalone. }}
{{#if this.isStandalone}}
  {{outlet}}
{{else}}
  <ShellChrome>
    {{outlet}}
  </ShellChrome>
  {{! Auto-upgrade feature spotlight — mounts the ds-tour corner card once per user,
      right after they reach the signed-in shell. Renders nothing itself. }}
  <span hidden {{auto-upgrade-promo this.session this.router}}></span>
{{/if}}
