{{! A single form section: bordered section header + a fields wrapper (default
    .sform__fields; pass @bodyClass="sform__addl" for the accordion group). }}
<section class="sform__section">
  <ds-section-header
    style-variant="with-border"
    size="large"
    title={{@title}}
    description={{@description}}
  ></ds-section-header>
  <div class={{if @bodyClass @bodyClass "sform__fields"}}>
    {{yield}}
  </div>
</section>
