{{! Detail skeleton — a RecordHeader strip (title + meta pills) + widget cards.
    The grid gives the first card the narrow column (donut) and the rest fill. }}
<div class="sk-detail" aria-hidden="true" role="status" aria-label="Loading">
  <div class="sk-detailhead">
    <div class="sk sk-detailhead__icon"></div>
    <div class="sk-detailhead__text">
      <div class="sk sk-detailhead__title"></div>
      <div class="sk-detailhead__meta">
        {{#each this.metaCells}}<div class="sk sk-metapill"></div>{{/each}}
      </div>
    </div>
  </div>
  <div class="sk-detailbody">
    {{#each this.cards}}<div class="sk sk-detailcard"></div>{{/each}}
  </div>
</div>
