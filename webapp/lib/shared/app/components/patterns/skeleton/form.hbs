{{! Form skeleton — section blocks, each a bordered header + left-labelled fields. }}
<div class="sk-form" aria-hidden="true" role="status" aria-label="Loading">
  {{#each this.sections as |s|}}
    <div class="sk-form__section">
      <div class="sk-form__head"><div class="sk sk-form__title"></div></div>
      <div class="sk-form__fields">
        {{#each this.fields as |f|}}
          <div class="sk-form__row">
            <div class="sk sk-form__label"></div>
            <div class="sk sk-form__control"></div>
          </div>
        {{/each}}
      </div>
    </div>
  {{/each}}
</div>
