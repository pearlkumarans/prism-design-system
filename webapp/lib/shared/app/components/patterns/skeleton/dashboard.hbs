{{! Dashboard skeleton — KPI row + a grid of widget/card placeholders. }}
<div class="sk-dash" aria-hidden="true" role="status" aria-label="Loading">
  <div class="sk-kpis">
    {{#each this.kpiCells}}<div class="sk sk-kpi"></div>{{/each}}
  </div>
  <div class="sk-cardgrid">
    {{#each this.cards}}<div class="sk sk-card"></div>{{/each}}
  </div>
</div>
