{{! Patterns::EmptyState — L13. Centered Prism empty state that fills its parent
    (whole page, or inside a scroll/card). Pass a block for an HTML description. }}
<div class="emptystate">
  <ds-empty-state
    type={{this.type}}
    illustration={{@illustration}}
    title={{@title}}
    description={{@description}}
    primary-label={{@primaryLabel}}
    secondary-label={{@secondaryLabel}}
    show-secondary={{this.showSecondary}}
    {{on "ds-empty-state-primary" this.onPrimary}}
    {{on "ds-empty-state-secondary" this.onSecondary}}
  >{{yield}}</ds-empty-state>
</div>
