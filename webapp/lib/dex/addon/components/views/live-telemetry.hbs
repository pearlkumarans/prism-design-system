{{! Live telemetry — per-device real-time metric feed (L04), a thin
    Patterns::ListDetail instance: record header + CPU/mem/disk/net time-series bento. }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" prefix-icon="refresh">Refresh</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load telemetry"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onLive}}
      <div class="ld-grid">
        <ds-widget class="sp3" type="chart" title="CPU %" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="line" area=true fit="fill" data=this.cpuChart}}></ds-widget>

        <ds-widget class="sp3" type="chart" title="Memory %" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="line" area=true fit="fill" data=this.memChart}}></ds-widget>

        <ds-widget class="sp3" type="chart" title="Disk I/O %" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="line" fit="fill" data=this.diskChart}}></ds-widget>

        <ds-widget class="sp3" type="chart" title="Network (Mbps)" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="line" fit="fill" data=this.netChart}}></ds-widget>

        <ds-widget class="sp6" type="table" title="Top processes" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="5" page="1"
            {{set-prop "columns" this.processColumns}} {{set-prop "rows" this.processRows}}></ds-data-table>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Live is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
