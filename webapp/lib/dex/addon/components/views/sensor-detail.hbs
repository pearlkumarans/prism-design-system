{{! Sensor detail — a DEX sensor drill-down (L04), a thin Patterns::ListDetail
    instance: record header + Overview (script · targets · recent runs). }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" prefix-icon="refresh">Run now</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load sensor"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp4" title="Script" show-drag="false" show-action="false" show-footer="false">
          <pre class="tl-out mono">{{this.script}}</pre>
        </ds-widget>

        <ds-widget class="sp2" type="list" title="Targets" show-drag="false" show-action="false" show-footer="false">
          <div>
            {{#each this.targets as |t|}}
              <div class="wl-row">
                <span class="wl-ico"><ds-icon name="product" size="16"></ds-icon></span>
                <span class="wl-label">{{t.type}}</span>
                <span class="wl-val">{{t.value}}</span>
              </div>
            {{/each}}
          </div>
        </ds-widget>

        <ds-widget class="sp6" type="table" title="Recent runs" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="5" page="1"
            {{set-prop "columns" this.runColumns}} {{set-prop "rows" this.runRows}}></ds-data-table>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
