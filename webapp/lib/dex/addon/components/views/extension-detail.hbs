{{! Extension detail — a DEX marketplace listing (L04), a thin Patterns::ListDetail
    instance: record header + Overview (problem · solution · features · About). }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="primary" size="small" prefix-icon="download">{{this.installLabel}}</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load extension"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp4" title="Problem statement" show-drag="false" show-action="false" show-footer="false">
          <p class="xd-para">{{this.problem}}</p>
        </ds-widget>

        <ds-widget class="sp2" title="About" show-drag="false" show-action="false" show-footer="false">
          <ds-description-list columns="1" {{set-prop "items" this.aboutItems}}></ds-description-list>
        </ds-widget>

        <ds-widget class="sp4" title="Solution" show-drag="false" show-action="false" show-footer="false">
          <p class="xd-para">{{this.solution}}</p>
        </ds-widget>

        <ds-widget class="sp2" type="list" title="Key features" show-drag="false" show-action="false" show-footer="false">
          <div>
            {{#each this.features as |f|}}
              <div class="wl-row">
                <span class="wl-ico" style="background: var(--uems-bg-success-primary); color: var(--uems-icon-success)"><ds-icon name="circle-tick" size="16"></ds-icon></span>
                <span class="wl-label">{{f}}</span>
              </div>
            {{/each}}
          </div>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
