{{! Alert detail — a DEX alert drill-down (L04), a thin Patterns::ListDetail
    instance: record header + Overview bento (event timeline + affected devices). }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" suffix-icon="chevron-down">Actions</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load alert"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp3" type="list" title="Event timeline" show-drag="false" show-action="false" show-footer="false">
          <div class="ld-list">
            {{#each this.timeline as |e|}}
              <div class="ld-arow">
                <span class="ld-arow__ico ld-arow__ico--{{e.state}}"><ds-icon name="circle-tick" size="18"></ds-icon></span>
                <div class="ld-arow__body">
                  <div class="ld-arow__title">{{e.event}}</div>
                  <div class="ld-arow__meta">
                    {{#if e.detail}}<span>{{e.detail}}</span><span class="ld-sep">|</span>{{/if}}
                    <span>{{e.when}}</span>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        </ds-widget>

        <ds-widget class="sp3" type="table" title="Affected devices" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="5" page="1"
            {{set-prop "columns" this.deviceColumns}} {{set-prop "rows" this.deviceRows}}></ds-data-table>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
