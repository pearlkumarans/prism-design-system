{{! Insight detail — a DEX experience-insight drill-down (L04), a thin
    Patterns::ListDetail instance: record header + Overview bento. }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" suffix-icon="chevron-down">Actions</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load insight"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp4" type="chart" title="Affected devices — 14 day trend" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="line" area=true fit="fill" data=this.trendChart}}></ds-widget>

        <ds-widget class="sp2" type="chart" title="Contributing factors" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="donut" legend="right" fit="contain" data=this.factorsChart}}></ds-widget>

        <ds-widget class="sp4" type="table" title="Affected devices" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="8" page="1"
            {{set-prop "columns" this.deviceColumns}} {{set-prop "rows" this.deviceRows}}></ds-data-table>
        </ds-widget>

        <ds-widget class="sp2" type="list" title="Recommended remediation" show-drag="false" show-action="false" show-footer="false">
          <div>
            {{#each this.remediationRows as |r|}}
              <div class="wl-row">
                <span class="wl-ico" style="background: var(--uems-bg-success-primary); color: var(--uems-icon-success)"><ds-icon name="circle-tick" size="16"></ds-icon></span>
                <span class="wl-label">{{r.action}}</span>
              </div>
            {{/each}}
          </div>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
