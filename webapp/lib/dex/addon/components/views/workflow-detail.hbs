{{! Workflow detail — a DEX workflow drill-down (L04), a thin Patterns::ListDetail
    instance: record header + Overview (step flow + recent runs). }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" prefix-icon="edit">Edit workflow</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load workflow"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp3" type="list" title="Steps" show-drag="false" show-action="false" show-footer="false">
          <div class="ld-list">
            {{#each this.steps as |s|}}
              <div class="ld-arow">
                <span class="ld-arow__ico ld-arow__ico--{{s.state}}"><ds-icon name={{s.icon}} size="18"></ds-icon></span>
                <div class="ld-arow__body">
                  <div class="ld-arow__title">{{s.label}}</div>
                  <div class="ld-arow__meta">
                    <ds-status-indicator class="ld-arow__tag" status={{s.state}} label={{s.kind}} size="medium"></ds-status-indicator>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        </ds-widget>

        <ds-widget class="sp3" type="table" title="Recent runs" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="5" page="1"
            {{set-prop "columns" this.runColumns}} {{set-prop "rows" this.runRows}}></ds-data-table>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
