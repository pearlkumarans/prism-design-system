{{! DEX devices — a thin Patterns::ListView instance (PrismAPI.dex.devices), fully
    localized (i18n header/columns/KPIs/facets + localized enum option labels). The
    device name drills into dex-device-detail via @onRowLink. }}
<Patterns::ListView
  @header={{this.header}}
  @fetch={{this.fetch}}
  @columns={{this.columns}}
  @facets={{this.localizedFacets}}
  @facetOptionLabel={{this.facetOptionLabel}}
  @kpis={{this.kpis}}
  @onRowLink={{this.openDevice}}
/>
