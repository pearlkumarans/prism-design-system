{{! Report detail — a DEX report drill-down (L04), a thin Patterns::ListDetail
    instance: record header + Overview (trend chart · parameters · metric table). }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" prefix-icon="download">Download</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load report"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp4" type="chart" title="Experience score — last 4 weeks" show-drag="false" show-action="false" show-footer="false"
          {{config-chart type="line" area=true fit="fill" data=this.chart}}></ds-widget>

        <ds-widget class="sp2" title="Parameters" show-drag="false" show-action="false" show-footer="false">
          <ds-description-list columns="1" {{set-prop "items" this.paramItems}}></ds-description-list>
        </ds-widget>

        <ds-widget class="sp6" type="table" title="Metrics" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="6" page="1"
            {{set-prop "columns" this.metricColumns}} {{set-prop "rows" this.metricRows}}></ds-data-table>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
