{{! Alert profile detail — a DEX alert-profile config (L04), a thin
    Patterns::ListDetail instance: record header + Overview (rules · targets · notification). }}
<Patterns::ListDetail
  @header={{this.header}}
  @breadcrumbs={{this.breadcrumbs}}
  @summary={{this.summary}}
  @tabs={{this.tabs}}
  @refitKey={{this.refitKey}}
  @onTabChange={{this.onTabChange}}
  @onBreadcrumbClick={{this.onBreadcrumbClick}}
>
  <:headerActions>
    <ds-button slot="actions" variant="outline" size="small" prefix-icon="edit">Edit profile</ds-button>
  </:headerActions>

  <:body>
    {{#if this.error}}
      <div class="ld-facet-empty">
        <Patterns::EmptyState @illustration="state-error" @title="Couldn't load profile"
          @description="The request failed. Is the BFF running (server/bff.mjs)?"
          @primaryLabel="Retry" @onPrimary={{this.retry}} />
      </div>
    {{else if this.onOverview}}
      <div class="ld-grid">
        <ds-widget class="sp4" type="table" title="Alert rules" show-drag="false" show-action="false" show-footer="false">
          <ds-data-table selection-mode="none" row-height="comfortable" show-toolbar="false" show-footer="false" sticky-header rows-per-page="8" page="1"
            {{set-prop "columns" this.ruleColumns}} {{set-prop "rows" this.ruleRows}}></ds-data-table>
        </ds-widget>

        <ds-widget class="sp2" type="list" title="Targets" show-drag="false" show-action="false" show-footer="false">
          <div>
            {{#each this.targets as |t|}}
              <div class="wl-row">
                <span class="wl-ico"><ds-icon name="product" size="16"></ds-icon></span>
                <span class="wl-label">{{t.type}}</span>
                <span class="wl-val">{{t.value}}</span>
              </div>
            {{/each}}
          </div>
        </ds-widget>

        <ds-widget class="sp6" title="Notification" show-drag="false" show-action="false" show-footer="false">
          <ds-description-list columns="2" {{set-prop "items" this.notificationItems}}></ds-description-list>
        </ds-widget>
      </div>
    {{else}}
      <div class="ld-facet-empty">
        <ds-empty-state show-illustration="false" show-secondary="false" show-primary="false"
          title="{{this.facetLabel}} — demo facet"
          description="This facet is a demo; Overview is the primary view."></ds-empty-state>
      </div>
    {{/if}}
  </:body>
</Patterns::ListDetail>
