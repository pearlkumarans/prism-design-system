# Copy this file to server/.env and fill in your values. server/.env is git-ignored —
# NEVER commit real credentials. The dev proxy (server/dev-proxy.mjs) loads it on start.

# Where the proxy listens (optional; default 8090)
PORT=8090

# Backend the /proxy/* prefix forwards to
EMS_TARGET=http://ems-ds:8020

# ── Auth (pick ONE approach) ────────────────────────────────────────────────
# A) Stable API key (recommended — generate once in the EC console; doesn't expire):
#    put it in the Authorization cookie value below.
# B) A live browser session (expires — re-grab from DevTools when it does).
#
# Session cookies the proxy attaches to every forwarded request:
EMS_COOKIE=UEMJSESSIONID=xxxx; UEMJSESSIONIDSSO=xxxx; Authorization=your-api-key-or-session-token; dccookcsr=xxxx
# CSRF header value (EC double-submit token; matches the dccookcsr cookie):
EMS_CSRF=dcparamcsr=xxxx
