# ── Dependencies ────────────────────────────────────────────────────────────
# Matches node_modules at any depth (e.g. design-system-library/node_modules/).
node_modules/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
.vite/
coverage/

# ── Logs & environment ──────────────────────────────────────────────────────
*.log
npm-debug.log*
.env
.env.local
.env.*.local

# ── Archives (build artifacts) ──────────────────────────────────────────────
# Excludes prism-ds.zip and similar. Force-add with `git add -f <file>.zip`
# if a particular archive is meant to be tracked.
*.zip

# ── OS & editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Backup / snapshot files (editor artifacts, never commit) ─────────────────
*.bak
*.orig
*.old
*~
# Ad-hoc snapshot suffixes like components.css.before-mobile-padding
*.css.before-*
*.css.after-*
*.css.pre-*
*.css.post-*

# ── Claude Code ─────────────────────────────────────────────────────────────
# Keep the shared assets (.claude/skills, launch.json, preview-server.py) —
# ignore only the per-machine local settings.
.claude/settings.local.json

# local dev secrets (never commit)
server/.env
.env
