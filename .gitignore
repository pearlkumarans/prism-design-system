# ── Dependencies ────────────────────────────────────────────────────────────
# Matches node_modules at any depth (e.g. design-system-library/node_modules/).
node_modules/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
.vite/
coverage/

# ── Generated reports (point-in-time snapshots, e.g. code-health) ────────────
reports/
**/reports/

# ── Visual-regression: commit baselines, ignore transient failure/diff output ─
**/screenshots/**/failed/

# ── Logs & environment ──────────────────────────────────────────────────────
*.log
npm-debug.log*
.env
.env.local
.env.*.local

# ── Archives (build artifacts) ──────────────────────────────────────────────
# Excludes prism-ds.zip and similar. Force-add with `git add -f <file>.zip`
# if a particular archive is meant to be tracked.
*.zip

# ── OS & editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Backup / snapshot files (editor artifacts, never commit) ─────────────────
*.bak
*.orig
*.old
*~
# Ad-hoc snapshot suffixes like components.css.before-mobile-padding
*.css.before-*
*.css.after-*
*.css.pre-*
*.css.post-*

# ── Claude Code ─────────────────────────────────────────────────────────────
# Keep the shared assets (.claude/skills, launch.json, preview-server.py) —
# ignore only the per-machine local settings.
.claude/settings.local.json

# ── Third-party agent skills (`npx skills add <owner>/<repo>`) ───────────────
# The CLI writes skill packs to /.agents/skills/ and symlinks each one into
# /.claude/skills/. Both are machine-local installs, not repo content, so they
# stay out of git — while /.claude/skills/ ITSELF remains tracked, because our
# own ec-ux / ec-critique / ec-strategy / generate-layout skills live there.
# That is why the symlinks are ignored by name rather than ignoring the folder.
# Installing another pack? Add its symlink prefix here too.
/.agents/
/.claude/skills/catalyst-*
# Lock file the skills CLI writes (pins installed packs + content hashes) — a
# per-machine tooling artifact, like the packs above.
skills-lock.json

# local dev secrets (never commit)
server/.env
.env
